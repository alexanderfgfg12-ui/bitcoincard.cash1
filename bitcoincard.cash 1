  padding: 8px 0;
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(10px);
}

.lang-bar .container { display: flex; justify-content: flex-end; }

#langSelect {
  background: var(--surface);
  color: var(--text);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 8px;
  padding: 8px 14px;
  font-size: 0.95rem;
  cursor: pointer;
  outline: none;
  transition: border-color 0.2s;
}

#langSelect:hover, #langSelect:focus { border-color: var(--accent); }

.hero {
  text-align: center;
  padding: 100px 20px;
  background: radial-gradient(ellipse at top, rgba(91,108,255,0.25), transparent 70%);
}

.hero h1 { font-size: 3.5rem; margin-bottom: 16px; }
.tagline { font-size: 1.3rem; color: var(--muted); margin-bottom: 40px; }

.cta-group { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

.btn {
  padding: 14px 32px;
  border-radius: 12px;
  text-decoration: none;
  font-weight: 600;
  font-size: 1.05rem;
  transition: transform 0.2s, box-shadow 0.2s;
  display: inline-block;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #fff;
}

.btn-secondary {
  background: var(--surface);
  color: var(--text);
  border: 1px solid rgba(255,255,255,0.1);
}

.btn:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0,212,170,0.3); }

section { padding: 80px 20px; }
h2 { font-size: 2.2rem; margin-bottom: 40px; text-align: center; }

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
}

.card {
  background: var(--surface);
  padding: 32px;
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,0.05);
  transition: border-color 0.3s;
}

.card:hover { border-color: var(--accent); }
.card h3 { margin-bottom: 12px; font-size: 1.2rem; }
.card p { color: var(--muted); }

.product-links {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
}

.product-link {
  background: var(--surface);
  padding: 32px;
  border-radius: 16px;
  text-decoration: none;
  color: var(--text);
  border: 1px solid rgba(255,255,255,0.05);
  transition: all 0.3s;
  text-align: center;
}

.product-link:hover {
  border-color: var(--accent-2);
  transform: translateY(-4px);
}

.product-link span { font-size: 2.5rem; display: block; margin-bottom: 12px; }
.product-link p { color: var(--muted); font-size: 0.95rem; }

.stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 24px;
  text-align: center;
  background: var(--surface);
  border-radius: 20px;
  margin: 40px auto;
  max-width: 1060px;
  padding: 40px 20px;
}

.stat strong { display: block; font-size: 1.8rem; color: var(--accent); }
.stat span { color: var(--muted); font-size: 0.9rem; }

footer {
  text-align: center;
  padding: 40px 20px;
  color: var(--muted);
  font-size: 0.9rem;
  border-top: 1px solid rgba(255,255,255,0.05);
}

footer code { background: var(--surface); padding: 2px 8px; border-radius: 6px; }

html[dir="rtl"] .lang-bar .container { justify-content: flex-start; }

@media (max-width: 640px) {
  .hero { padding: 60px 20px; }
  .hero h1 { font-size: 2.2rem; }
  .tagline { font-size: 1.05rem; }
  h2 { font-size: 1.6rem; }
  .btn { padding: 12px 24px; font-size: 0.95rem; }
  section { padding: 50px 20px; }
